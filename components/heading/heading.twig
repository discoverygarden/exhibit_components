{# Markup for the heading component #}

{% set heading_classes = [
  'dgi-uikit-heading',
  (alignment ? 'uk-text-' ~ alignment : null),
  (divider ? 'uk-heading-divider' : null),
  (bullet ? 'uk-heading-bullet' : null),
  (line ? 'uk-heading-line' : null)
] %}

{# Generate a unique ID for each heading #}
{% set id_pattern = '[^A-Za-z0-9_.-]' %}
{% set heading_id = 'dgi-heading-' ~ heading|lower|replace({' ': '-', '_': '-'})|replace({(id_pattern): ''}, '', true)|clean_id %}

<div{{ attributes.addClass('dgi-heading') }}>
  {% if heading is not empty %}
    <h{{ level }}{{ attributes.addClass(heading_classes) }} id="{{ heading_id }}">
      {% if line %}<span>{% endif %}
      {{ heading }}
      {% if line %}</span>{% endif %}
    </h{{ level }}>
  {% endif %}
</div>
