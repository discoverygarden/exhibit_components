{# Markup for the heading component #}

{% set heading_classes = [
  'dgi-uikit-heading',
  (alignment ? 'uk-text-' ~ alignment : null),
  (divider ? 'uk-heading-divider' : null),
  (bullet ? 'uk-heading-bullet' : null),
  (line ? 'uk-heading-line' : null)
] %}

<div{{ attributes.addClass('dgi-heading') }}>
  {% if heading is not empty %}
    <h{{ level }}{{ attributes.addClass(heading_classes) }}>
      {% if line %}<span>{% endif %}
      {{ heading }}
      {% if line %}</span>{% endif %}
    </h{{ level }}>
  {% endif %}
</div>
