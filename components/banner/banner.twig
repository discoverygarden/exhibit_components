{# Markup for the banner component #}

{% if not attributes %}
  {% set attributes = create_attribute() %}
{% endif %}

{% if banner_caption is not empty %}
  <figure>
{% endif %}
<div class="uk-cover-container uk-height-medium uk-padding uk-padding-remove-left uk-padding-remove-right uk-padding-remove-top">
  {% if banner_image is not empty %}
    <div>
      <img style="opacity:{{ banner_opacity|default('.3') }}" src="{{ banner_image }}" alt="{{ banner_alt_text }}" uk-cover>
    </div>
  {% endif %}

  {% if banner_title is not empty or banner_summary is not empty %}
    <div class="{{ banner_color_mode }} uk-padding uk-cover-container">
      {% if banner_title is not empty %}
        <h2 class="uk-text-bold">{{ banner_title }}</h2>
      {% endif %}
      {% if banner_summary is not empty %}
        <p class="uk-text-normal">{{ banner_summary }}</p>
      {% endif %}
    </div>
  {% endif %}
</div>
{% if banner_caption is not empty %}
  <figcaption class="{{ banner_caption_classes|safe_join(' ') }}">{{ banner_caption|nl2br }}</figcaption>
  </figure>
{% endif %}
