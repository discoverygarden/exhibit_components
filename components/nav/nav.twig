{# Markup for the nav component #}

{# Variables #}
{% set base_class = 'dgi-nav' %}
{% set base_id = auto_gen ? 'dgi-nav-auto-gen' : 'dgi-nav' %}

<div {{ attributes.addClass(base_class) }} id="{{ base_id }}">
  {% if not auto_gen %}
    {% if items is defined and items is not empty %}
      <div class="uk-margin uk-width-expand@m">
        <ul class="uk-nav uk-nav-divider" {{ expanded ?: create_attribute({'uk-nav': ''}) }}>
          {% for nav_entry in items %}
            <li class="uk-parent uk-nav-secondary">
              <a href="#"><div class="uk-text-emphasis">{{ nav_entry.label }}</div> <span uk-nav-parent-icon></span></a>
              <ul class="uk-nav-sub">
                {% for nav_link in nav_entry.links %}
                  <li><a href="{{ nav_link.url }}">{{ nav_link.title }}</a></li>
                {% endfor %}
              </ul>
            </li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  {% else %}
    <div class="uk-margin uk-width-expand@m">
      <ul class="uk-nav uk-nav-divider" {{ expanded ?: create_attribute({'uk-nav': ''}) }}>
        <li class="uk-parent uk-nav-secondary"></li>
      </ul>
    </div>
  {% endif %}
</div>
