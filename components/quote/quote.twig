{# Markup for the quote component #}

{# Variables #}
{% set base_class = 'dgi-quote' %}

<div {{ attributes.addClass(base_class) }}>
  <blockquote cite="#">
    <p class="uk-margin-remove">{{ quote }}</p>
    {% if link is not empty %}
      <footer><a href="{{ link }}" title="Resource representing {{ author }}" aria-label="Resource representing {{ author }}" rel="nofollow" target="_blank">{{ author }}</a></footer>
    {% else %}
      <footer>{{ author }}</footer>
    {% endif %}
  </blockquote>
</div>
