{#
/**
 * @file
 * Default template for the grid paragraph type SDC.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 *   Only method names starting with "get", "has", or "is" and a few common
 *   methods such as "id", "label", and "bundle" are available. For example:
 *   - paragraph.getCreatedTime() will return the paragraph creation timestamp.
 *   - paragraph.id(): The paragraph ID.
 *   - paragraph.bundle(): The type of the paragraph, for example, "image" or "text".
 *   - paragraph.getOwnerId(): The user ID of the paragraph author.
 *   See Drupal\paragraphs\Entity\Paragraph for a full list of public properties
 *   and methods for the paragraph object.
 * - content: All paragraph items. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}. Use
 *   {{ content|without('field_example') }} to temporarily suppress the printing
 *   of a given child element.
 * - attributes: HTML attributes for the containing element.
 *   The attributes.class element may contain one or more of the following
 *   classes:
 *   - paragraphs: The current template type (also known as a "theming hook").
 *   - paragraphs--type-[type]: The current paragraphs type. For example, if the paragraph is an
 *     "Image" it would result in "paragraphs--type--image". Note that the machine
 *     name will often be in a short form of the human readable label.
 *   - paragraphs--view-mode--[view_mode]: The View Mode of the paragraph; for example, a
 *     preview would result in: "paragraphs--view-mode--preview", and
 *     default: "paragraphs--view-mode--default".
 * - view_mode: View mode; for example, "preview" or "full".
 * - logged_in: Flag for authenticated user status. Will be true when the
 *   current user is a logged-in member.
 * - is_admin: Flag for admin user status. Will be true when the current user
 *   is an administrator.
 *
 * @see template_preprocess_paragraph()
 *
 * @ingroup themeable
 */
#}

{%
  set classes = [
  'paragraph',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished'
]
%}

{% set grid_items = []  %}

{% block paragraph %}
  <div{{ attributes.addClass(classes) }}>
    {% block content %}
      {% for key, item in paragraph.field_uikit_grid_item %}
        {% set card_title = item.entity.field_uikit_card_title.value %}
        {% set card_image_url = file_url(item.entity.field_uikit_card_media.entity.field_media_image.entity.uri.value) %}
        {% set card_size_modifier = item.entity.field_uikit_size_modifier.value %}
        {% set card_image_alt = item.entity.field_uikit_card_media.entity.field_media_image.alt ?? "" %}
        {% set card_media_position = item.entity.field_uikit_card_media_position.value %}
        {% set card_badge = item.entity.field_uikit_card_badge.value %}
        {% set card_badge = item.entity.field_uikit_card_badge.value %}
        {% set card_body = item.entity.field_uikit_card_body.value %}
        {% set card_width_modifier = item.entity.field_uikit_width_class.value %}
        {% set media_image = file_url(item.entity.field_uikit_card_media.entity.field_media_image.entity.uri.value) %}
        {% set media_alt = item.entity.field_uikit_card_media.entity.field_media_image.alt ?? "" %}
        {% set card_title_link = item.entity.field_uikit_card_title_link.value %}

        {% set card_image_width = "" %}
        {% set card_image_height = "" %}

        {% if card_image_url is not empty %}
          {% set card_image_width = item.entity.field_uikit_card_media.entity.field_media_image.0.width %}
          {% set card_image_height = item.entity.field_uikit_card_media.entity.field_media_image.0.height %}
        {% endif %}


        {% set grid_items = grid_items|merge([{
          'heading': card_title,
          'size_modifier': card_size_modifier,
          'image': card_image_url,
          'image_alt': card_image_alt,
          'media_position': card_media_position,
          'badge': card_badge,
          'card_body': card_body,
          'width_modifier': card_width_modifier,
          'image_width': card_image_width,
          'image_height': card_image_height,
          'title_link': card_title_link
        }]) %}
      {% endfor %}

      {% set divider_modifier_value = paragraph.field_uikit_divider_modifier.value ? true : false %}
      {{ include('exhibit_components:grid', {
        heading: content.field_uikit_grid_title,
        gap_modifier: paragraph.field_uikit_grid_gap.value,
        divider_modifier: divider_modifier_value,
        column_number_small: paragraph.field_uikit_grid_col_sm.value,
        column_number_medium: paragraph.field_uikit_grid_col_md.value,
        column_number_large: paragraph.field_uikit_grid_col_lg.value,
        column_number_extra_large: paragraph.field_uikit_grid_col_xl.value,
        items: grid_items},
        with_context = false)
      }}

    {% endblock %}
  </div>
{% endblock paragraph %}
